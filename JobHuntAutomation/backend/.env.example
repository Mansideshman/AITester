DATABASE_URL="file:./dev.db"
PORT=8420

# Preferred fetch source — free within RapidAPI's JSearch monthly quota, covers both
# LinkedIn- and Indeed-sourced postings in one call. If set, this is used instead of Apify.
JSEARCH_API_KEY=

# Paid fallback fetch source, used only if JSEARCH_API_KEY is not set.
APIFY_TOKEN=

ANTHROPIC_API_KEY=
