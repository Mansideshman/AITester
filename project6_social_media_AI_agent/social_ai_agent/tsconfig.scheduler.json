{
  "compilerOptions": {
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "outDir": "./dist",
    "target": "ES2020",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules"]
}
