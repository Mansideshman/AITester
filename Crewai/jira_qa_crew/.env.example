APP_NAME=Jira QA Crew
APP_ENV=development
OUTPUT_DIR=outputs

# Groq via LiteLLM. LLM_MODEL is the bare model name (no "groq/" prefix -- that's added in code).
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# auto: try MCP, fall back to REST. mcp: MCP only. rest: REST only.
JIRA_INTEGRATION_MODE=auto
JIRA_URL=https://your-domain.atlassian.net
JIRA_AUTH_MODE=basic
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BEARER_TOKEN=
JIRA_API_VERSION=3
JIRA_ACCEPTANCE_CRITERIA_FIELD=
JIRA_INCLUDE_COMMENTS=false
JIRA_MAX_COMMENTS=20

JIRA_MCP_TRANSPORT=streamable_http
JIRA_MCP_URL=
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS_JSON=[]
JIRA_MCP_HEADERS_JSON={}
JIRA_MCP_GET_ISSUE_TOOL=
JIRA_MCP_TIMEOUT_SECONDS=20

PIPELINE_MAX_TICKETS=20
PIPELINE_MAX_RETRIES=2
PIPELINE_TICKET_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO

# When true, Jira fields come from fixtures/demo_tickets.json instead of MCP/REST.
# Never enabled automatically as a fallback for a failed live call -- only this flag.
DEMO_MODE=false
