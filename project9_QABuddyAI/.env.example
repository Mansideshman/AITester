# --- Chunking (source-type-specific defaults live in qabuddy/config.py's
#     CHUNK_PARAMS; these are only the prose fallback) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings (BGE-M3: dense + sparse from one model, run locally) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MAX_LENGTH=512
BGE_USE_FP16=0
INGEST_BATCH=16

# --- Reranker (local cross-encoder, always — no hosted fallback on a VPS) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Vector store (Qdrant) ---
# Leave QDRANT_URL unset to use the embedded file-store at ./qdrant_data
# (no Docker needed). Set it to point at a standalone Qdrant server instead.
QDRANT_URL=
COLLECTION_NAME=qabuddy

# --- Retrieval ---
TOP_N_HYBRID=20
TOP_K_RERANK=4
RRF_K=60
REWRITE_ENABLED=1
NUM_REWRITES=3

# --- LLM (Groq by default; set OPENROUTER_API_KEY to switch providers) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
GENERATION_MODEL=
REWRITE_MODEL=
