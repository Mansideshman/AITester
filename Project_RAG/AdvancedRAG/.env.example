# --- LLM ---
# This app defaults to Groq's OpenAI-compatible API for both query rewriting
# and generation (same key you already use for BasicRAG). Set
# OPENROUTER_API_KEY instead to switch providers with no code changes.
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GENERATION_MODEL=openai/gpt-oss-120b
# REWRITE_MODEL=llama-3.1-8b-instant

# --- Qdrant ---
# Leave unset to run Qdrant embedded (file store at ./qdrant_data/, no Docker).
# Set to point at a real Qdrant server instead, e.g. http://localhost:6333
# QDRANT_URL=

# --- Tunables (defaults shown) ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_N_HYBRID=20
# TOP_K_RERANK=4
# RRF_K=60
# REWRITE_ENABLED=1
# BGE_USE_FP16=0
# INGEST_BATCH=16
# PORT=5050
